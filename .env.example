# ─────────────────────────────────────────────────────────────────────
# Copie para .env e preencha. NUNCA commite o .env (já está no .gitignore)
#
#   cp .env.example .env
#
# O endpoint precisa ser ARCHIVE (servir estado histórico), senão
# `vm.createSelectFork("mainnet", <bloco antigo>)` falha com:
#   "pruned history unavailable"
# ─────────────────────────────────────────────────────────────────────

# Endpoint archive de Ethereum mainnet.
# Testado e funcionando (archive, free):
ETHEREUM_RPC_URL=https://eth-pokt.nodies.app

# Alternativas pagas/recomendadas p/ trabalho sério:
#   Alchemy  : https://eth-mainnet.g.alchemy.com/v2/<KEY>
#   QuickNode: https://<slug>.mainnet.quiknode.pro/<TOKEN>/
#   Infura   : https://mainnet.infura.io/v3/<KEY>
#   Tenderly  : https://mainnet.gateway.tenderly.co
#
# Só-latest (NÃO serve archive — ok p/ forkar em 'latest'):
#   https://ethereum-rpc.publicnode.com
#   https://rpc.flashbots.net

# Endpoints auxiliares de Layer 2 (usados nos labs do F1/F2)
#   ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
#   OPTIMISM_RPC_URL=https://mainnet.optimism.io
#   BASE_RPC_URL=https://mainnet.base.org